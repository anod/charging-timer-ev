<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- No sharedpref include: charging_completion.xml is device-local delivery state. -->
        <include domain="database" path="charging.db" />
        <include domain="database" path="charging.db-journal" />
        <include domain="database" path="charging.db-wal" />
        <include domain="file" path=".charging_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer charging_completion.xml: never restore a stale completion alert. -->
        <include domain="database" path="charging.db" />
        <include domain="database" path="charging.db-journal" />
        <include domain="database" path="charging.db-wal" />
        <include domain="file" path=".charging_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
